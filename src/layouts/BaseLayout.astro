---
import en from '../i18n/en.json';
import vi from '../i18n/vi.json';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

const enData = JSON.stringify(en);
const viData = JSON.stringify(vi);
---
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content={description}>
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700;900&family=Quicksand:wght@400;500;600;700&display=swap" rel="stylesheet" media="print" onload="this.media='all'">
    <link rel="shortcut icon" type="image/x-icon" href="/demo/assets/images/anh_cuoi/IMG_0411_square_og_img.jpg">
    <slot name="head" />
    <style>
        *{margin:0;padding:0;box-sizing:border-box}
        body{font-family:'Quicksand',sans-serif;background:#f4f0ec;color:#444;line-height:1.8}
        .navbar{background:#fff;border-bottom:1px solid #e8e0d8;padding:0 20px;height:60px;display:flex;align-items:center;justify-content:space-between;position:sticky;top:0;z-index:100}
        .navbar .logo{font-family:'Playfair Display',serif;font-size:1.3em;font-weight:700;color:#2d1b2e;text-decoration:none}
        .navbar .logo span{color:#ff4061}
        .nav-links{display:flex;gap:25px;list-style:none}
        .nav-links a{color:#555;text-decoration:none;font-weight:500;font-size:.95em}
        .nav-links a:hover,.nav-links a.active{color:#ff4061}
        .nav-toggle{display:none;background:none;border:none;font-size:1.5em;cursor:pointer;color:#2d1b2e}
        .lang-dropdown{position:relative;margin-left:10px}
        .lang-toggle{display:flex;align-items:center;gap:5px;background:linear-gradient(135deg,#f8f6f4,#fff);border:1px solid #e0d8d0;border-radius:6px;padding:5px 11px;font-size:.78em;cursor:pointer;font-weight:600;color:#555;font-family:inherit;transition:all .25s;box-shadow:0 1px 3px rgba(0,0,0,.04)}
        .lang-toggle:hover{border-color:#ff4061;color:#ff4061;box-shadow:0 2px 8px rgba(255,64,97,.1)}
        .lang-toggle .globe{font-size:1.15em;line-height:1}
        .lang-toggle .arrow{font-size:.55em;transition:transform .25s ease;margin-left:1px}
        .lang-dropdown.open .lang-toggle{border-color:#ff4061;box-shadow:0 2px 8px rgba(255,64,97,.1)}
        .lang-dropdown.open .lang-toggle .arrow{transform:rotate(180deg)}
        .lang-menu{position:absolute;top:100%;right:0;margin-top:7px;background:#fff;border:1px solid #e8e0d8;border-radius:10px;box-shadow:0 8px 30px rgba(0,0,0,.1);min-width:150px;overflow:hidden;z-index:200;opacity:0;visibility:hidden;transform:translateY(-4px);transition:all .2s ease}
        .lang-dropdown.open .lang-menu{opacity:1;visibility:visible;transform:translateY(0)}
        .lang-opt{display:flex;align-items:center;gap:8px;width:100%;padding:10px 14px;text-align:left;background:none;border:none;font-size:.82em;cursor:pointer;color:#555;transition:background .15s;font-family:inherit}
        .lang-opt:hover{background:#fef0f3;color:#ff4061}
        .lang-opt.active{color:#ff4061;font-weight:600;background:#fff5f7}

        @media(max-width:820px){
            .nav-links{display:none;position:absolute;top:60px;left:0;right:0;background:#fff;flex-direction:column;padding:15px 20px;gap:12px;border-bottom:1px solid #e8e0d8;box-shadow:0 4px 12px rgba(0,0,0,.08)}
            .nav-links.open{display:flex}
            .nav-toggle{display:block}
        }
    </style>
</head>
<body>
    <nav class="navbar">
        <a href="/" class="logo">Wedding<span>Template</span></a>
        <div style="display:flex;align-items:center">
            <button class="nav-toggle" id="navToggle" aria-label="Menu">☰</button>
            <div class="lang-dropdown" id="langDropdown">
                <button class="lang-toggle" id="langToggle" aria-haspopup="true" aria-expanded="false">
                    <span class="globe">🌐</span>
                    <span id="langLabel">English</span>
                    <span class="arrow">▾</span>
                </button>
                <div class="lang-menu" role="menu">
                    <button class="lang-opt active" data-lang="en" role="menuitem">English</button>
                    <button class="lang-opt" data-lang="vi" role="menuitem">Tiếng Việt</button>
                </div>
            </div>
        </div>
        <ul class="nav-links" id="navLinks">
            <li><a href="/" data-i18n="langNavHome">Home</a></li>
            <li><a href="/demo/" data-i18n="langNavDemo">Demo</a></li>
            <li><a href="/products/" data-i18n="langNavProducts">Products</a></li>
            <li><a href="/blog/" data-i18n="langNavBlog">Blog</a></li>
        </ul>
    </nav>

    <slot />

    <footer style="background:#222;color:#888;text-align:center;padding:30px 20px;font-size:14px;border-top:3px solid #ff4061">
        <div style="display:flex;justify-content:center;gap:20px;margin:10px 0;flex-wrap:wrap">
            <a href="/" style="color:#aaa;text-decoration:none" data-i18n="langNavHome">Home</a>
            <a href="/demo/" style="color:#aaa;text-decoration:none" data-i18n="langNavDemo">Demo</a>
            <a href="/products/" style="color:#aaa;text-decoration:none" data-i18n="langNavProducts">Products</a>
            <a href="/blog/" style="color:#aaa;text-decoration:none" data-i18n="langNavBlog">Blog</a>
        </div>
        <p data-i18n="langFooterPowered">Powered by Free Wedding Website Template</p>
        <p style="font-size:.85em;margin-top:5px" data-i18n="langFooterAffiliate">Some links are affiliate links. We may earn a commission at no extra cost to you.</p>
    </footer>

    <script set:html={`const __i18n={en:${enData},vi:${viData}};
var ln={en:'English',vi:'Ti\u1ebfng Vi\u1ec7t'};
var dd=document.getElementById('langDropdown');
var lb=document.getElementById('langLabel');
function applyLang(l){var t=__i18n[l];document.documentElement.lang=l;
document.querySelectorAll('[data-i18n]').forEach(function(e){var k=e.getAttribute('data-i18n');if(t[k]){e.textContent=t[k];if(e.tagName==='IMG')e.alt=t[k]}});
document.querySelectorAll('.lang-opt').forEach(function(b){b.classList.toggle('active',b.getAttribute('data-lang')===l)});
lb.textContent=ln[l]||l.toUpperCase();localStorage.setItem('lang',l);dd.classList.remove('open');
dd.querySelector('.lang-toggle').setAttribute('aria-expanded','false')}
document.addEventListener('click',function(e){
var t=e.target.closest('.lang-toggle');var o=e.target.closest('.lang-opt');
if(t){e.stopPropagation();dd.classList.toggle('open');t.setAttribute('aria-expanded',dd.classList.contains('open'))}
else if(o)applyLang(o.getAttribute('data-lang'));
else if(!e.target.closest('.lang-dropdown')){dd.classList.remove('open');dd.querySelector('.lang-toggle').setAttribute('aria-expanded','false')}});
var s=localStorage.getItem('lang');if(s==='en'||s==='vi')applyLang(s);
document.getElementById('navToggle').addEventListener('click',function(e){e.stopPropagation();document.getElementById('navLinks').classList.toggle('open')});
document.addEventListener('click',function(e){if(!e.target.closest('.navbar'))document.getElementById('navLinks').classList.remove('open')});`}></script>
</body>
</html>
