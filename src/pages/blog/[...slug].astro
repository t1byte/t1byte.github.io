---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();
---

<BaseLayout title={`${post.data.title} — Wedding Blog`} description={post.data.description}>
  <style>
    .article-header{background:linear-gradient(135deg,#2d1b2e,#4a2c4a);padding:60px 20px 50px;text-align:center;color:#fff}
    .article-header .cat{display:inline-block;background:rgba(255,255,255,.15);color:#ffd4d4;font-size:.8em;font-weight:600;padding:3px 14px;border-radius:20px;margin-bottom:12px}
    .article-header h1{font-family:'Playfair Display',serif;font-size:2.2em;max-width:750px;margin:0 auto 10px}
    .article-header .meta{font-size:.9em;opacity:.75}
    .layout{display:flex;gap:40px;max-width:1100px;margin:0 auto;padding:40px 20px}
    .main{flex:1;min-width:0}
    .sidebar{width:300px;flex-shrink:0}
    .content h2{font-family:'Playfair Display',serif;color:#2d1b2e;font-size:1.6em;margin:40px 0 15px;padding-bottom:8px;border-bottom:2px solid #e8ddd0}
    .content h3{color:#4a2c4a;margin:25px 0 10px;font-size:1.15em}
    .content p{margin-bottom:16px}
    .content ul,.content ol{margin:0 0 20px 25px}
    .content li{margin-bottom:8px}
    .content blockquote{background:#fff4eb;border-left:4px solid #ff8a8a;padding:16px 20px;margin:24px 0;border-radius:0 10px 10px 0;font-size:.95em}
    .content blockquote strong{color:#d4536a}
    .content hr{margin:30px 0;border:none;border-top:1px solid #e0d8d0}
    .content a{color:#ff4061}
    .breadcrumb{font-size:.9em;color:#999;margin-bottom:20px;padding:8px 0}
    .breadcrumb a{color:#999;text-decoration:none}
    .breadcrumb a:hover{color:#ff4061}
    .sidebar-widget{background:#fff;border-radius:12px;padding:25px;margin-bottom:25px;box-shadow:0 2px 12px rgba(0,0,0,.05)}
    .sidebar-widget h3{font-family:'Playfair Display',serif;color:#2d1b2e;font-size:1.15em;margin-bottom:15px;padding-bottom:8px;border-bottom:2px solid #f0e8e0}
    .sidebar-widget p{font-size:.9em;color:#666;margin-bottom:12px}
    .sidebar-widget ul{list-style:none}
    .sidebar-widget li{margin-bottom:10px;padding-bottom:10px;border-bottom:1px solid #f5f0eb}
    .sidebar-widget li:last-child{border:none;margin:0;padding:0}
    .sidebar-widget li a{color:#555;text-decoration:none;font-size:.92em}
    .sidebar-widget li a:hover{color:#ff4061}
    .sidebar-widget .btn{display:block;background:#ff4061;color:#fff;text-align:center;padding:12px;border-radius:8px;text-decoration:none;font-weight:600;font-size:.95em}
    .sidebar-widget .btn:hover{background:#d93654}
    .nav-links-section{margin-top:40px;padding-top:20px;border-top:1px solid #ddd5cc}
    .nav-links-section a{color:#ff4061;text-decoration:none;font-weight:500}
    @media(max-width:820px){
      .layout{flex-direction:column;padding:25px 15px}
      .sidebar{width:100%}
      .article-header h1{font-size:1.6em}
      .article-header{padding:40px 15px 30px}
      .content h2{font-size:1.3em}
    }
  </style>

  <article>
    <header class="article-header">
      <span class="cat">{post.data.category}</span>
      <h1>{post.data.title}</h1>
      <p class="meta">{post.data.date.toLocaleDateString('en-US', { year:'numeric', month:'long', day:'numeric' })} · {post.data.readTime} read</p>
    </header>
    <div class="layout">
      <main class="main content">
        <div class="breadcrumb">
          <a href="/">Home</a> <span style="margin:0 6px">›</span>
          <a href="/blog/">Blog</a> <span style="margin:0 6px">›</span>
          <span style="color:#555">{post.data.title}</span>
        </div>
        <Content />
        <div class="nav-links-section">
          <a href="/blog/">← Back to Blog</a>
        </div>
      </main>
      <aside class="sidebar">
        <div class="sidebar-widget">
          <h3>💍 Free Template</h3>
          <p>Create your own wedding website with our beautiful, free template.</p>
          <a class="btn" href="/demo/">View Demo →</a>
          <div style="text-align:center;margin-top:8px"><small><a href="https://github.com/t1byte/t1byte.github.io" style="color:#999">Get on GitHub</a></small></div>
        </div>
        <div class="sidebar-widget">
          <h3>📂 Categories</h3>
          <ul>
            <li><a href="/blog/">Planning (1)</a></li>
            <li><a href="/blog/">Website & Tech (1)</a></li>
          </ul>
        </div>
        <div class="sidebar-widget">
          <h3>🛍️ Wedding Essentials</h3>
          <ul>
            <li><a href="https://amzn.to/4fV2R3X" target="_blank" rel="nofollow sponsored">Photo Booth Rental →</a></li>
            <li><a href="https://amzn.to/3ZYXabc" target="_blank" rel="nofollow sponsored">Portable Bluetooth Speaker →</a></li>
          </ul>
          <div style="margin-top:10px;font-size:.78em;color:#aaa">As an Amazon Associate we earn from qualifying purchases.</div>
        </div>
      </aside>
    </div>
  </article>
</BaseLayout>
