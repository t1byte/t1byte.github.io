---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog', ({ data }) => data.date <= new Date());
posts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title="Wedding Blog — Planning Tips & Free Templates" description="Free wedding planning tips, checklists, and inspiration. Plan your dream wedding with our comprehensive guides.">
  <style>
    .hero{background:linear-gradient(135deg,#2d1b2e,#4a2c4a);padding:70px 20px;text-align:center;color:#fff}
    .hero h1{font-family:'Playfair Display',serif;font-size:2.6em;margin-bottom:8px}
    .hero p{font-size:1.1em;opacity:.85}
    .layout{display:flex;gap:40px;max-width:1100px;margin:0 auto;padding:40px 20px}
    .main{flex:1;min-width:0}
    .sidebar{width:300px;flex-shrink:0}
    .post{background:#fff;border-radius:12px;padding:30px;margin-bottom:25px;box-shadow:0 2px 12px rgba(0,0,0,.05)}
    .post .cat{display:inline-block;background:#fef0f3;color:#ff4061;font-size:.8em;font-weight:600;padding:3px 12px;border-radius:20px;margin-bottom:10px}
    .post h2{font-family:'Playfair Display',serif;font-size:1.5em;color:#2d1b2e;margin-bottom:8px}
    .post h2 a{color:#2d1b2e;text-decoration:none}
    .post h2 a:hover{color:#ff4061}
    .post .meta{font-size:.88em;color:#999;margin-bottom:12px}
    .post p{color:#555;margin-bottom:14px}
    .post .read-more{display:inline-flex;align-items:center;gap:5px;color:#ff4061;font-weight:600;text-decoration:none;font-size:.95em}
    .post .read-more:hover{text-decoration:underline}
    .sidebar-widget{background:#fff;border-radius:12px;padding:25px;margin-bottom:25px;box-shadow:0 2px 12px rgba(0,0,0,.05)}
    .sidebar-widget h3{font-family:'Playfair Display',serif;color:#2d1b2e;font-size:1.15em;margin-bottom:15px;padding-bottom:8px;border-bottom:2px solid #f0e8e0}
    .sidebar-widget p{font-size:.9em;color:#666;margin-bottom:12px}
    .sidebar-widget ul{list-style:none}
    .sidebar-widget li{margin-bottom:10px;padding-bottom:10px;border-bottom:1px solid #f5f0eb}
    .sidebar-widget li:last-child{border:none;margin:0;padding:0}
    .sidebar-widget li a{color:#555;text-decoration:none;font-size:.92em}
    .sidebar-widget li a:hover{color:#ff4061}
    .sidebar-widget .btn{display:block;background:#ff4061;color:#fff;text-align:center;padding:12px;border-radius:8px;text-decoration:none;font-weight:600;font-size:.95em}
    .sidebar-widget .btn:hover{background:#d93654}
    .breadcrumb{font-size:.9em;color:#999;margin-bottom:20px;padding:8px 0}
    .breadcrumb a{color:#999;text-decoration:none}
    .breadcrumb a:hover{color:#ff4061}
    @media(max-width:820px){
      .layout{flex-direction:column;padding:25px 15px}
      .sidebar{width:100%}
      .hero h1{font-size:1.8em}
      .hero{padding:50px 15px}
      .post{padding:20px}
    }
  </style>

  <header class="hero">
    <h1>Wedding Planning Blog</h1>
    <p>Free tips, checklists & inspiration for your perfect day</p>
  </header>

  <div class="layout">
    <main class="main">
      <div class="breadcrumb">
        <a href="/">Home</a> <span style="margin:0 6px">›</span>
        <span style="color:#555">Blog</span>
      </div>

      {posts.map((post) => (
        <article class="post">
          <span class="cat">{post.data.category}</span>
          <h2><a href={'/blog/' + post.slug + '/'}>{post.data.title}</a></h2>
          <div class="meta">{post.data.date.toLocaleDateString('en-US', { year:'numeric', month:'long', day:'numeric' })} · {post.data.readTime} read</div>
          <p>{post.data.description}</p>
          <a class="read-more" href={'/blog/' + post.slug + '/'}>Read More →</a>
        </article>
      ))}
    </main>

    <aside class="sidebar">
      <div class="sidebar-widget">
        <h3>💍 Free Template</h3>
        <p>Create your own wedding website with our beautiful, free template.</p>
        <a class="btn" href="/demo/">View Demo →</a>
      </div>

      <div class="sidebar-widget">
        <h3>📂 Categories</h3>
        <ul>
          <li><a href="/blog/">Planning (1)</a></li>
          <li><a href="/blog/">Website & Tech (1)</a></li>
        </ul>
      </div>

      <div class="sidebar-widget">
        <h3>📝 Recent Posts</h3>
        <ul>
          {posts.slice(0, 5).map((post) => (
            <li><a href={'/blog/' + post.slug + '/'}>{post.data.title}</a></li>
          ))}
        </ul>
      </div>
    </aside>
  </div>
</BaseLayout>
