---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const products = await getCollection('products');
  return products.map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }));
}

const { product } = Astro.props;
const { Content } = await product.render();
---

<BaseLayout title={`${product.data.title} — Digital Products`} description={product.data.description}>
  <style>
    .product-header{background:linear-gradient(135deg,#2d1b2e,#4a2c4a);padding:60px 20px 50px;text-align:center;color:#fff}
    .product-header .cat{display:inline-block;background:rgba(255,255,255,.15);color:#ffd4d4;font-size:.8em;font-weight:600;padding:3px 14px;border-radius:20px;margin-bottom:12px}
    .product-header h1{font-family:'Playfair Display',serif;font-size:2.2em;max-width:750px;margin:0 auto 10px}
    .product-header .price-tag{font-size:1.5em;font-weight:700;color:#ff4061;margin-top:10px}
    .layout{display:flex;gap:40px;max-width:1100px;margin:0 auto;padding:40px 20px}
    .main{flex:1;min-width:0}
    .sidebar{width:300px;flex-shrink:0}
    .product-image{width:100%;border-radius:12px;overflow:hidden;box-shadow:0 4px 20px rgba(0,0,0,.08);margin-bottom:30px}
    .product-image img{width:100%;display:block}
    .content h2{font-family:'Playfair Display',serif;color:#2d1b2e;font-size:1.6em;margin:40px 0 15px;padding-bottom:8px;border-bottom:2px solid #e8ddd0}
    .content h3{color:#4a2c4a;margin:25px 0 10px;font-size:1.15em}
    .content p{margin-bottom:16px}
    .content ul,.content ol{margin:0 0 20px 25px}
    .content li{margin-bottom:8px}
    .content blockquote{background:#fff4eb;border-left:4px solid #ff8a8a;padding:16px 20px;margin:24px 0;border-radius:0 10px 10px 0;font-size:.95em}
    .content blockquote strong{color:#d4536a}
    .content hr{margin:30px 0;border:none;border-top:1px solid #e0d8d0}
    .content a{color:#ff4061}
    .buy-box{background:#fff;border-radius:12px;padding:25px;text-align:center;box-shadow:0 2px 12px rgba(0,0,0,.05);margin-bottom:25px}
    .buy-box .price{font-family:'Playfair Display',serif;font-size:2em;font-weight:700;color:#ff4061;margin-bottom:15px}
    .buy-box .btn{display:block;background:#ff4061;color:#fff;padding:14px;border-radius:8px;text-decoration:none;font-weight:600;font-size:1.1em}
    .buy-box .btn:hover{background:#d93654}
    .breadcrumb{font-size:.9em;color:#999;margin-bottom:20px;padding:8px 0}
    .breadcrumb a{color:#999;text-decoration:none}
    .breadcrumb a:hover{color:#ff4061}
    .sidebar-widget{background:#fff;border-radius:12px;padding:25px;margin-bottom:25px;box-shadow:0 2px 12px rgba(0,0,0,.05)}
    .sidebar-widget h3{font-family:'Playfair Display',serif;color:#2d1b2e;font-size:1.15em;margin-bottom:15px;padding-bottom:8px;border-bottom:2px solid #f0e8e0}
    .sidebar-widget ul{list-style:none}
    .sidebar-widget li{margin-bottom:10px;padding-bottom:10px;border-bottom:1px solid #f5f0eb}
    .sidebar-widget li:last-child{border:none;margin:0;padding:0}
    .sidebar-widget li a{color:#555;text-decoration:none;font-size:.92em}
    .sidebar-widget li a:hover{color:#ff4061}
    .nav-links-section{margin-top:40px;padding-top:20px;border-top:1px solid #ddd5cc}
    .nav-links-section a{color:#ff4061;text-decoration:none;font-weight:500}
    @media(max-width:820px){
      .layout{flex-direction:column;padding:25px 15px}
      .sidebar{width:100%}
      .product-header h1{font-size:1.6em}
      .product-header{padding:40px 15px 30px}
      .content h2{font-size:1.3em}
    }
  </style>

  <article>
    <header class="product-header">
      <span class="cat">{product.data.category}</span>
      <h1>{product.data.title}</h1>
      <p style="opacity:.85;max-width:600px;margin:10px auto 0">{product.data.description}</p>
      <div class="price-tag">{product.data.price === 0 ? '$0.00' : '$' + product.data.price.toFixed(2)}</div>
    </header>
    <div class="layout">
      <main class="main">
        <div class="breadcrumb">
          <a href="/" data-i18n="langBreadcrumbHome">Home</a> <span style="margin:0 6px">›</span>
          <a href="/products/" data-i18n="langBreadcrumbProducts">Products</a> <span style="margin:0 6px">›</span>
          <span style="color:#555">{product.data.title}</span>
        </div>

        <div class="product-image">
          <img src={product.data.image} alt={product.data.title}>
        </div>

        <div class="content">
          <Content />
        </div>

        <div class="nav-links-section">
          <a href="/products/" data-i18n="langBackToProducts">← Back to Products</a>
        </div>
      </main>

      <aside class="sidebar">
        <div class="buy-box">
          <div class="price">{product.data.price === 0 ? '$0.00' : '$' + product.data.price.toFixed(2)}</div>
          <a class="btn" href={product.data.externalUrl} target="_blank" rel="noopener" data-i18n="langBuyNow">Buy Now →</a>
        </div>

        <div class="sidebar-widget">
          <h3 data-i18n="langSidebarTemplateTitle">💍 Free Template</h3>
          <p data-i18n="langSidebarTemplateDesc">Create your own wedding website with our beautiful, free template.</p>
          <a class="btn" href="/demo/" style="display:block;background:#ff4061;color:#fff;text-align:center;padding:12px;border-radius:8px;text-decoration:none;font-weight:600;font-size:.95em" data-i18n="langSidebarTemplateBtn">View Demo →</a>
        </div>

        <div class="sidebar-widget">
          <h3 data-i18n="langSidebarCategories">📂 Categories</h3>
          <ul>
            <li><a href="/products/">Templates</a></li>
            <li><a href="/products/">Presets</a></li>
            <li><a href="/products/">Fonts</a></li>
          </ul>
        </div>
      </aside>
    </div>
  </article>
</BaseLayout>