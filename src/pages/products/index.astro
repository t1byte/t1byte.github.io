---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const products = await getCollection('products');
products.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const categories = [...new Set(products.map((p) => p.data.category))];
const featured = products.filter((p) => p.data.featured);
---

<BaseLayout title="Digital Products — Wedding & Design Assets" description="Premium digital assets for your wedding and creative projects. Templates, presets, and more.">
  <style>
    .hero{background:linear-gradient(135deg,#2d1b2e,#4a2c4a);padding:70px 20px;text-align:center;color:#fff}
    .hero h1{font-family:'Playfair Display',serif;font-size:2.6em;margin-bottom:8px}
    .hero p{font-size:1.1em;opacity:.85}
    .layout{display:flex;gap:40px;max-width:1100px;margin:0 auto;padding:40px 20px}
    .main{flex:1;min-width:0}
    .sidebar{width:300px;flex-shrink:0}
    .featured-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:25px;margin-bottom:50px}
    .featured-card{background:#fff;border-radius:16px;overflow:hidden;box-shadow:0 4px 20px rgba(0,0,0,.08);transition:transform .2s}
    .featured-card:hover{transform:translateY(-4px)}
    .featured-card img{width:100%;aspect-ratio:16/10;object-fit:cover;display:block}
    .featured-card .body{padding:20px}
    .featured-card .cat{display:inline-block;background:#fef0f3;color:#ff4061;font-size:.75em;font-weight:600;padding:2px 10px;border-radius:20px;margin-bottom:8px}
    .featured-card h3{font-family:'Playfair Display',serif;font-size:1.15em;color:#2d1b2e;margin-bottom:6px}
    .featured-card p{font-size:.9em;color:#666;margin-bottom:12px;line-height:1.5}
    .featured-card .footer{display:flex;justify-content:space-between;align-items:center}
    .featured-card .price{font-family:'Playfair Display',serif;font-size:1.3em;font-weight:700;color:#ff4061}
    .featured-card .btn{background:#ff4061;color:#fff;padding:8px 20px;border-radius:20px;text-decoration:none;font-weight:600;font-size:.85em}
    .featured-card .btn:hover{background:#d93654}
    .section-title{font-family:'Playfair Display',serif;font-size:1.5em;color:#2d1b2e;margin-bottom:20px;padding-bottom:8px;border-bottom:2px solid #e8ddd0}
    .grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:20px}
    .card{background:#fff;border-radius:12px;overflow:hidden;box-shadow:0 2px 12px rgba(0,0,0,.05);transition:transform .2s}
    .card:hover{transform:translateY(-3px)}
    .card img{width:100%;aspect-ratio:16/10;object-fit:cover;display:block}
    .card .body{padding:16px}
    .card .cat{display:inline-block;background:#fef0f3;color:#ff4061;font-size:.72em;font-weight:600;padding:2px 8px;border-radius:20px;margin-bottom:6px}
    .card h3{font-family:'Playfair Display',serif;font-size:1em;color:#2d1b2e;margin-bottom:4px}
    .card h3 a{color:#2d1b2e;text-decoration:none}
    .card h3 a:hover{color:#ff4061}
    .card p{font-size:.85em;color:#666;margin-bottom:10px;line-height:1.4}
    .card .footer{display:flex;justify-content:space-between;align-items:center}
    .card .price{font-weight:700;color:#ff4061;font-size:1.05em}
    .card .btn{background:#ff4061;color:#fff;padding:6px 16px;border-radius:20px;text-decoration:none;font-weight:600;font-size:.8em}
    .card .btn:hover{background:#d93654}
    .sidebar-widget{background:#fff;border-radius:12px;padding:25px;margin-bottom:25px;box-shadow:0 2px 12px rgba(0,0,0,.05)}
    .sidebar-widget h3{font-family:'Playfair Display',serif;color:#2d1b2e;font-size:1.15em;margin-bottom:15px;padding-bottom:8px;border-bottom:2px solid #f0e8e0}
    .sidebar-widget ul{list-style:none}
    .sidebar-widget li{margin-bottom:10px;padding-bottom:10px;border-bottom:1px solid #f5f0eb}
    .sidebar-widget li:last-child{border:none;margin:0;padding:0}
    .sidebar-widget li a{color:#555;text-decoration:none;font-size:.92em}
    .sidebar-widget li a:hover{color:#ff4061}
    .breadcrumb{font-size:.9em;color:#999;margin-bottom:20px;padding:8px 0}
    .breadcrumb a{color:#999;text-decoration:none}
    .breadcrumb a:hover{color:#ff4061}
    @media(max-width:820px){
      .layout{flex-direction:column;padding:25px 15px}
      .sidebar{width:100%}
      .hero h1{font-size:1.8em}
      .hero{padding:50px 15px}
      .featured-grid{grid-template-columns:1fr}
      .grid{grid-template-columns:repeat(auto-fill,minmax(200px,1fr))}
    }
  </style>

  <header class="hero">
    <h1 data-i18n="langProductsHeroTitle">Digital Products</h1>
    <p data-i18n="langProductsHeroDesc">Premium assets for your wedding & creative projects</p>
  </header>

  <div class="layout">
    <main class="main">
      <div class="breadcrumb">
        <a href="/" data-i18n="langBreadcrumbHome">Home</a> <span style="margin:0 6px">›</span>
        <span style="color:#555" data-i18n="langBreadcrumbProducts">Products</span>
      </div>

      {featured.length > 0 && (
        <>
          <h2 class="section-title" data-i18n="langFeatured">Featured</h2>
          <div class="featured-grid">
            {featured.map((product) => (
              <div class="featured-card">
                <img src={product.data.image} alt={product.data.title} loading="lazy">
                <div class="body">
                  <span class="cat">{product.data.category}</span>
                  <h3><a href={'/products/' + product.slug + '/'} style="color:#2d1b2e;text-decoration:none">{product.data.title}</a></h3>
                  <p>{product.data.description}</p>
                  <div class="footer">
                    <span class="price">{product.data.price === 0 ? '$0.00' : '$' + product.data.price.toFixed(2)}</span>
                    <a class="btn" href={product.data.externalUrl} target="_blank" rel="noopener" data-i18n="langBuyNow">Buy Now →</a>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </>
      )}

      <h2 class="section-title" data-i18n="langAllProducts">All Products</h2>
      <div class="grid">
        {products.map((product) => (
          <div class="card">
            <img src={product.data.image} alt={product.data.title} loading="lazy">
            <div class="body">
              <span class="cat">{product.data.category}</span>
              <h3><a href={'/products/' + product.slug + '/'}>{product.data.title}</a></h3>
              <p>{product.data.description}</p>
              <div class="footer">
                <span class="price">{product.data.price === 0 ? '$0.00' : '$' + product.data.price.toFixed(2)}</span>
                <a class="btn" href={product.data.externalUrl} target="_blank" rel="noopener" data-i18n="langBuyNow">Buy Now →</a>
              </div>
            </div>
          </div>
        ))}
      </div>
    </main>

    <aside class="sidebar">
      <div class="sidebar-widget">
        <h3 data-i18n="langSidebarCategories">📂 Categories</h3>
        <ul>
          {categories.map((cat) => (
            <li><a href="/products/">{cat}</a></li>
          ))}
        </ul>
      </div>

      <div class="sidebar-widget">
        <h3 data-i18n="langSidebarTemplateTitle">💍 Free Template</h3>
        <p data-i18n="langSidebarTemplateDesc">Create your own wedding website with our beautiful, free template.</p>
        <a class="btn" href="/demo/" style="display:block;background:#ff4061;color:#fff;text-align:center;padding:12px;border-radius:8px;text-decoration:none;font-weight:600;font-size:.95em" data-i18n="langSidebarTemplateBtn">View Demo →</a>
      </div>

      {featured.length > 0 && (
        <div class="sidebar-widget">
          <h3 data-i18n="langSidebarFeatured">⭐ Featured</h3>
          <ul>
            {featured.slice(0, 4).map((product) => (
              <li><a href={'/products/' + product.slug + '/'}>{product.data.title}</a></li>
            ))}
          </ul>
        </div>
      )}
    </aside>
  </div>
</BaseLayout>